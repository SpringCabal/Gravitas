set shell := ["bash", "-cu"]

fmt:
    cargo fmt --all

clippy:
    cargo clippy --workspace --target wasm32-unknown-unknown --release -- -D warnings

# host tests of the rules-ui messages
test:
    cargo test -p gravitas-shared --target x86_64-unknown-linux-gnu

build: fmt clippy
    cargo build --workspace --target wasm32-unknown-unknown --release

copy: build
    cp target/wasm32-unknown-unknown/release/gravitas_jobs_wasm.wasm ../LuaUI/wasm/gravitas-jobs.wasm
    cp target/wasm32-unknown-unknown/release/gravitas_rules_wasm.wasm ../LuaRules/wasm/gravitas-rules.wasm
    cp target/wasm32-unknown-unknown/release/gravitas_ui_wasm.wasm ../LuaUI/wasm/gravitas-ui.wasm
